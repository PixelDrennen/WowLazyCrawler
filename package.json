{
  "name": "wowlazycrawler",
  "version": "0.4.0",
  "description": "Self-hosted WoW auction and crafting intelligence",
  "author": {
    "name": "Drennen Dooms"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "build:web": "npm --prefix web run build",
    "build:server": ".venv/bin/python -m PyInstaller --noconfirm --clean --onedir --name lazycrawler-server --distpath build/backend --workpath build/pyinstaller --add-data 'web/dist:web/dist' --add-data 'addon:addon' --collect-all uvicorn --collect-all server server_entry.py",
    "desktop": "npm run build:web && electron .",
    "package:linux": "npm run build:web && npm run build:server && npm run package:addon && electron-builder --linux rpm AppImage --publish never",
    "package:dir": "npm run build:web && npm run build:server && electron-builder --linux dir",
    "package:addon": "python3 scripts/package-addon.py"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "net.spectralfailure.wowlazycrawler",
    "productName": "WoW LazyCrawler",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/backend/lazycrawler-server",
        "to": "backend"
      }
    ],
    "linux": {
      "target": [
        "rpm",
        "AppImage"
      ],
      "category": "Utility",
      "executableName": "wowlazycrawler",
      "desktop": {
        "entry": {
          "StartupWMClass": "wowlazycrawler",
          "Keywords": "WoW;Auction;Crafting;"
        }
      },
      "icon": "desktop/icons",
      "syncDesktopName": true,
      "maintainer": "PixelDrennen"
    },
    "rpm": {
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libXScrnSaver",
        "libXdamage",
        "libXrandr",
        "mesa-libgbm",
        "libdrm",
        "libxkbcommon",
        "at-spi2-atk",
        "xdg-utils",
        "polkit"
      ],
      "fpm": [
        "--rpm-rpmbuild-define",
        "_build_id_links none"
      ]
    },
    "appImage": {
      "artifactName": "WoW-LazyCrawler-${version}-${arch}.AppImage"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "PixelDrennen",
        "repo": "WowLazyCrawler",
        "releaseType": "release"
      }
    ]
  },
  "desktopName": "wowlazycrawler.desktop",
  "homepage": "https://github.com/PixelDrennen/WowLazyCrawler",
  "repository": {
    "type": "git",
    "url": "https://github.com/PixelDrennen/WowLazyCrawler.git"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
